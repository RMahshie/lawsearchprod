# Backend Environment Variables
# Copy this file to .env and update the values

# === OpenAI Configuration ===
# REQUIRED: Get your API key from https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# === Chat Model Profile ===
# openai uses the default GPT profile. deepseek uses DeepSeek V4 Flash/Pro chat models.
LAWSEARCH_MODEL_PROFILE=openai

# Required only when LAWSEARCH_MODEL_PROFILE=deepseek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Required only when creating or querying Voyage-backed vector stores
VOYAGE_API_KEY=pa-your-voyage-api-key-here
